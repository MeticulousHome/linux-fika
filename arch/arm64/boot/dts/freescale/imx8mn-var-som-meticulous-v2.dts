 * Copyright 2025 Variscite Ltd.
 * Copyright 2025 Johanna Schander <git@mimoja.de>
 */

/dts-v1/;

#include "imx8mn-var-som-meticulous.dts"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "imx8mn-pinfunc.h"

/ {
	model = "Variscite VAR-SOM-MX8MN module V2";
	compatible = "variscite,var-som-mx8mn", "fsl,imx8mn";

	iw612_pwrseq: iw612_pwrseq {
		compatible = "mmc-pwrseq-simple";
		post-power-on-delay-ms = <100>;
		power-off-delay-us = <10000>;
		reset-gpios = <&gpio2 10 GPIO_ACTIVE_LOW>,	/* WIFI_RESET */
			          <&gpio2 20 GPIO_ACTIVE_LOW>;	/* WIFI_PWR_EN */
		status = "okay";
	};

};

/* Bluetooth */
&uart2 {
	status = "okay";
	uart-has-rtscts;
	bluetooth_iw61x: bluetooth_iw61x {
		compatible = "nxp,88w8987-bt";
		fw-init-baudrate = <3000000>;
		status = "okay";
	};
};


/* WIFI */
&usdhc1 {
	pinctrl-0 = <&pinctrl_usdhc1>, <&pinctrl_wifi_host_wake>;
	pinctrl-1 = <&pinctrl_usdhc1_100mhz>, <&pinctrl_wifi_host_wake>;
	pinctrl-2 = <&pinctrl_usdhc1_200mhz>, <&pinctrl_wifi_host_wake>;
	mmc-pwrseq = <&iw612_pwrseq>;

	status = "okay";

	// Delete the brcmf node as V2 uses the iw612 driver
	/delete-node/ brcmf;

	/*
	 * WIFI_HOST_WAKE: the IW612 pulls it low to wake the SoC from suspend
	 * (WoWLAN). moal looks this node up and arms it as a wake-up IRQ.
	 */
	wifi_wake_host {
		compatible = "nxp,wifi-wake-host";
		interrupt-parent = <&gpio3>;
		interrupts = <14 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "host-wake";
	};
};

&iomuxc {
	pinctrl_wifi_host_wake: wifihostwakegrp {
		fsl,pins = <
			MX8MN_IOMUXC_NAND_DQS_GPIO3_IO14	0x1c0
		>;
	};
};


// FIXME: The mxl8611x is not yet supported upstream, so we dont configure it at this point.
&ethphy {
	reset-deassert-us = <100000>;
};